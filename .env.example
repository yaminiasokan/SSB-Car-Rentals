# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- PostgreSQL ----
DATABASE_URL=postgresql://postgres:yami2005@localhost:5432/ssb_car_rentals
# Set to true for most managed hosts (Render, Neon, Supabase, RDS, ...)
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Creates/upgrades tables from db/schema.sql on startup. Defaults to true outside production.
DB_AUTO_MIGRATE=true

# ---- Auth ----
# Generate a long random string:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ssb_car_rentals_secret_balaji_2804
JWT_EXPIRES_IN=7d

# ---- Uploads ----
UPLOAD_MAX_MB=5

# ---- Seed ----
# Demo passwords used by `npm run seed` (change if you deploy the demo data anywhere public)
SEED_ADMIN_PASSWORD=Admin@123
SEED_STAFF_PASSWORD=Staff@123
SEED_CUSTOMER_PASSWORD=Customer@123
